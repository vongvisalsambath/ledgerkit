<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>LedgerKit.PostgreSql</PackageId>
    <Version>0.1.0</Version>
    <Authors>Vong Visalsambath</Authors>
    <Description>PostgreSQL storage for LedgerKit. The database itself refuses unbalanced entries and any change to posted ones.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/vongvisalsambath/ledgerkit</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LedgerKit/LedgerKit.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <EmbeddedResource Include="schema.sql" LogicalName="LedgerKit.PostgreSql.schema.sql" />
  </ItemGroup>
</Project>
